<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NU1510: the package is deliberately not pruned in favour of the shared framework copy. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The newest 10.0.x package, so the repro does not depend on the copy inside the shared framework. -->
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>
</Project>
