<Project>
  <!-- Root versions first; this file only adds the packages project 05 needs. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />
  <ItemGroup>
    <!-- 10.0.13 is the servicing release that matches the .NET 10.0.13 runtime in SDK 10.0.402. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Specification.Tests" Version="10.0.13" />
    <!-- The specification suite is written against xUnit v2 (xunit.extensibility.core 2.9.3), so the judge runs it with v2's own runner library. -->
    <PackageVersion Include="xunit.extensibility.execution" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.utility" Version="2.9.3" />
  </ItemGroup>
</Project>
